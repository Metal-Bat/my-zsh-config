# Copy to ~/.config/zsh/local.zsh (or $XDG_CONFIG_HOME/zsh/local.zsh).
# This file runs after the shared setup and before syntax highlighting.
# Keep machine-specific paths here so repository updates stay straightforward.

# Change the default city used by `wttr`.
# export WEATHER_CITY='Berlin'

# Use Emacs editing in the shell; the shared default is Vi editing.
# bindkey -e

# Show you-should-use alias reminders after the command finishes:
# export YSU_MESSAGE_POSITION='after'
# To stop these reminders, remove you-should-use from ~/.zshrc's plugin list.

# Private scripts. Test existence before adding aliases.
# if [[ -x "$HOME/.scripts/rename-files.py" ]]; then
#   alias rmf='"$HOME/.scripts/rename-files.py"'
# fi
# if [[ -x "$HOME/.flutter/bin/flutter" ]]; then
#   path+=("$HOME/.flutter/bin")
# fi

# Optional trusted JetBrains VM options file, only if you use it.
# [[ -r "$HOME/.jetbrains.vmoptions.sh" ]] && source "$HOME/.jetbrains.vmoptions.sh"

# Direct access to a project environment when that is explicitly wanted:
# alias project-python='"$HOME/projects/example/.venv/bin/python"'

# Add personal aliases below. Do not initialize mise, Atuin or zoxide again.
